/*
* Config for running cutadapt
*/


params{
    // *************************************
    // Cutadapt input params               *
    // *************************************

    // All inputs can be modified during cmd line input by user

    params.r1_adapters = "$projectDir/subworkflows/local/cutadapt/adapter_files/huScan_r1_adapters.fa"
    params.r2_adapters = "$projectDir/subworkflows/local/cutadapt/adapter_files/huScan_r2_adapters.fa"       
    
}