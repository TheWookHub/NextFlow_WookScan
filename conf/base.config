/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/wookflow Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // OLD SETTING SYNTAX
    //cpus   = { params.check_max( 16    * task.attempt, 'cpus'   ) }
    //memory = { params.check_max( 24.GB * task.attempt, 'memory' ) }
    //time   = { params.check_max( 24.h  * task.attempt, 'time'   ) }
    
    // TODO nf-core: Check the defaults for all processes
    cpus   = { 16    * task.attempt }
    memory = { 24.GB * task.attempt }
    time   = { 24.h  * task.attempt }
    
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 8     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 48.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 32    * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 240.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 31.d  * task.attempt }
        memory = { 32.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }


    // =======================================================
    //      ADD BIPS/DOLPHYN PROCESS CONFIGS HERE
    // =======================================================
    // |BIPS_CSV_TO_FASTA|RUN_DOLPHYN_PREDICTION|DOLPHYN_JSON_TO_CSV|SELECT_EPITOPE_POSITIVE_BIPS_OLIGOS|FILTER_BIPS_BARCODES|RUN_DOLPHYN_STANDALONE_PREP

    // Use a regular expression with 'withName' to match all of your custom processes
    withName: 'RUN_BIPS_INITIAL|BIPS_CSV_TO_FASTA|RUN_DOLPHYN_PREDICTION |PUBLISH_BIPS_RESULTS|DOLPHYN_JSON_TO_CSV|SELECT_EPITOPE_POSITIVE_BIPS_OLIGOS|FILTER_BIPS_BARCODES|RUN_DOLPHYN_STANDALONE_PREP' {
        // Apply the Conda environment to all these processes
        conda = "${projectDir}/bips_environment.yml"

        // Can also assign a specific label for resource management
        // For example, if they are all medium intensity:
        //label 'process_medium'
    }

    // Can even override settings for a single one if needed
    // withName: 'RUN_BIPS_INITIAL' {
    //     label 'process_high' // If BIPS is particularly demanding
    // }





    withName:CUSTOM_DUMPSOFTWAREVERSIONS {
        cache = false
    }
}
